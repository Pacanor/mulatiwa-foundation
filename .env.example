# Cybersource REST credentials (Business Center → Payment Configuration → Key Management)
MERCHANT_ID=zanaco_mulatiwafou
CYBS_KEY_ID=
CYBS_SECRET_KEY=

# test | production
CYBS_ENV=test

# Cybersource requires HTTPS origins only
# Comma-separated allowlist. The server also always allows its own HTTPS host.
TARGET_ORIGINS=https://localhost:8080,https://mulatiwa-foundation-2-qaz68.ondigitalocean.app

PORT=8080
NODE_ENV=development
# Local testing uses self-signed certs in server/certs (gitignored)
DEV_HTTPS=true

# Emails (Resend) — donor thank-you + staff alert
RESEND_API_KEY=
RESEND_FROM=Mulatiwa Foundation <donations@mulatiwafoundation.org>
DONATION_NOTIFY_EMAIL=e.munalula@mulatiwafoundation.org
PUBLIC_SITE_URL=https://mulatiwa-foundation-2-qaz68.ondigitalocean.app
# Used by POST /api/donate/test-email when body.email is omitted
TEST_DONOR_EMAIL=

# Local CSV ledger directory (writes data/donations.csv). On App Platform use a volume + DATA_DIR=/data
# DATA_DIR=

# Set to false to disable the Monday 08:30 CAT cron inside the Node process
WEEKLY_REPORT_CRON=true
# Keep true locally; set false in production App Platform
ALLOW_TEST_EMAIL=true

# HMAC secret for staff giving-log links in donation emails (falls back to CYBS_SECRET_KEY)
REPORT_SECRET=
